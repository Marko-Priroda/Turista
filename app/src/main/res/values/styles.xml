<resources>

    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/turista_forest</item>
        <item name="colorPrimaryVariant">@color/turista_forest_dark</item>
        <item name="colorSecondary">@color/turista_orange</item>
        <item name="colorAccent">@color/turista_orange</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/turista_forest_dark</item>
        <item name="android:navigationBarColor">@color/turista_forest_dark</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorControlHighlight">#2672A46B</item>
        <item name="android:buttonStyle">@style/TuristaSecondaryButton</item>
    </style>

    <style name="TuristaPrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">58dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/turista_white</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:elevation">3dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
    </style>

    <style name="TuristaSecondaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">58dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/turista_forest</item>
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:elevation">1dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
    </style>

    <style name="TuristaMenuRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="TuristaMenuIcon">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:padding">9dp</item>
        <item name="android:background">@drawable/bg_map_control</item>
        <item name="android:tint">@color/turista_white</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="TuristaMenuText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/turista_text</item>
    </style>
    <style name="TuristaSettingsSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/turista_moss</item>
    </style>
    <style name="TuristaSettingSwitch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/turista_text</item>
        <item name="switchPadding">16dp</item>
    </style>
    <style name="TuristaSettingDescription">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/turista_text_secondary</item>
    </style>
</resources>
