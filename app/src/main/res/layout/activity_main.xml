<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="46dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <ImageView
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:contentDescription="Logo Turista"
            android:elevation="8dp"
            android:src="@drawable/ic_launcher_turista" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.10"
            android:text="TURISTA"
            android:textColor="@color/turista_forest"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Mapa a navigácia pre tvoje dobrodružstvá"
            android:textColor="@color/turista_text_secondary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="42dp"
            android:layout_marginBottom="12dp"
            android:letterSpacing="0.08"
            android:text="MAPA A NAVIGÁCIA"
            android:textColor="@color/turista_moss"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMap"
            style="@style/TuristaPrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="14dp"
            android:drawableStart="@drawable/ic_map"
            android:drawablePadding="16dp"
            android:text="Otvoriť mapu" />

        <Button
            android:id="@+id/btnNature"
            style="@style/TuristaSecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="14dp"
            android:drawableStart="@drawable/ic_download"
            android:drawablePadding="16dp"
            android:text="Offline mapy a navigácia" />

        <Button
            android:id="@+id/btnHike"
            style="@style/TuristaSecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:drawableStart="@drawable/ic_route"
            android:drawablePadding="16dp"
            android:text="Naplánovať trasu" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_panel_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRIPRAVENÉ AJ BEZ SIGNÁLU"
                android:textColor="@color/turista_forest"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="Stiahni si mapu a routovacie dáta ešte pred túrou. Trasa, GPS aj kompas potom fungujú offline."
                android:textColor="@color/turista_text_secondary"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
