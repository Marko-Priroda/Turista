<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="false">
<LinearLayout 
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="8dp" android:background="@drawable/bg_panel_card">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="MENU" android:textSize="12sp" android:textStyle="bold"
        android:letterSpacing="0.12" android:textColor="@color/turista_text_secondary"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp" />
    <LinearLayout android:id="@+id/menuAccount" style="@style/TuristaMenuRow"><ImageView style="@style/TuristaMenuIcon" android:src="@drawable/ic_account" /><TextView style="@style/TuristaMenuText" android:text="Prihlásiť sa / účet" /></LinearLayout>
    <LinearLayout android:id="@+id/menuDownloads" style="@style/TuristaMenuRow">
        <ImageView style="@style/TuristaMenuIcon" android:src="@drawable/ic_download" />
        <TextView style="@style/TuristaMenuText" android:text="Sťahovanie máp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/menuSettings" style="@style/TuristaMenuRow">
        <ImageView style="@style/TuristaMenuIcon" android:src="@drawable/ic_settings" />
        <TextView style="@style/TuristaMenuText" android:text="Nastavenia" />
    </LinearLayout>
    <LinearLayout android:id="@+id/menuCompass" style="@style/TuristaMenuRow">
        <ImageView style="@style/TuristaMenuIcon" android:src="@drawable/ic_compass" />
        <TextView style="@style/TuristaMenuText" android:text="Kompas" />
    </LinearLayout>
    <LinearLayout android:id="@+id/menuRecognizer" style="@style/TuristaMenuRow">
        <ImageView style="@style/TuristaMenuIcon" android:src="@drawable/ic_recognizer" android:contentDescription="Rozpoznávač" />
        <TextView style="@style/TuristaMenuText" android:text="Rozpoznávač" />
    </LinearLayout>
    <LinearLayout android:id="@+id/menuSteps" style="@style/TuristaMenuRow">
        <ImageView style="@style/TuristaMenuIcon" android:src="@drawable/ic_steps" />
        <TextView style="@style/TuristaMenuText" android:text="Krokomer" />
    </LinearLayout>
    <LinearLayout android:id="@+id/menuRecord" style="@style/TuristaMenuRow">
        <ImageView style="@style/TuristaMenuIcon" android:src="@drawable/ic_record" />
        <TextView style="@style/TuristaMenuText" android:text="Nahrávanie trasy" />
    </LinearLayout>
    <LinearLayout android:id="@+id/menuSaved" style="@style/TuristaMenuRow">
        <ImageView style="@style/TuristaMenuIcon" android:src="@drawable/ic_saved" />
        <TextView style="@style/TuristaMenuText" android:text="Uložené" />
    </LinearLayout>
    <LinearLayout android:id="@+id/menuDonate" style="@style/TuristaMenuRow">
        <ImageView style="@style/TuristaMenuIcon" android:src="@drawable/ic_donate" />
        <TextView style="@style/TuristaMenuText" android:text="Dobrovoľný príspevok" />
    </LinearLayout>
</LinearLayout>
</ScrollView>