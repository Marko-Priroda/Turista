<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:maplibre="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mapRoot"
    android:background="@color/turista_sand"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- MAPA -->
    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        maplibre:maplibre_uiLogo="false"
        maplibre:maplibre_uiAttribution="false" />

    <com.marko.turista.RouteDrawingView android:id="@+id/routeDrawing"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:visibility="gone" android:contentDescription="Kreslenie vlastnej pešej trasy" />
    <!-- VYHĽADÁVANIE -->
    <EditText
        android:id="@+id/searchMap"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="top"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="80dp"
        android:background="@drawable/bg_search_field"
        android:hint="Hľadať miesto alebo adresu"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textSize="16sp"
        android:singleLine="true"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:textColor="@color/turista_text"
        android:textColorHint="@color/turista_text_secondary"
        android:elevation="6dp" />

    <!-- Menu stays transparent; image buttons avoid the Material Button tint. -->
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/mapMenuButton"
        android:layout_width="48dp" android:layout_height="48dp"
        android:layout_gravity="top|end" android:layout_marginTop="18dp" android:layout_marginEnd="14dp"
        android:background="@drawable/bg_menu_transparent" android:padding="10dp"
        android:elevation="32dp" android:contentDescription="Otvoriť menu" android:tooltipText="Menu"
        maplibre:srcCompat="@drawable/ic_menu" maplibre:tint="@null" maplibre:backgroundTint="@null" />

    <LinearLayout android:id="@+id/mapControls" android:elevation="32dp"
        android:layout_width="52dp" android:layout_height="wrap_content"
        android:layout_marginTop="84dp" android:layout_gravity="top|end" android:layout_marginEnd="16dp"
        android:orientation="vertical">
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/locationButton"
            android:layout_width="52dp" android:layout_height="52dp"
            android:background="@drawable/bg_map_control" android:padding="14dp"
            android:contentDescription="Moja poloha" android:tooltipText="Moja poloha"
            android:elevation="4dp" maplibre:srcCompat="@drawable/ic_location"
            maplibre:tint="@color/turista_white" maplibre:backgroundTint="@null" />
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/mapModesButton"
            android:layout_width="52dp" android:layout_height="52dp" android:layout_marginTop="12dp"
            android:background="@drawable/bg_map_control" android:padding="14dp"
            android:contentDescription="Vrstvy mapy" android:tooltipText="Vrstvy mapy"
            android:elevation="4dp" maplibre:srcCompat="@drawable/ic_layers"
            maplibre:tint="@color/turista_white" maplibre:backgroundTint="@null" />
    </LinearLayout>

    <!-- ====================================== -->
    <!-- PANEL VYBRANÉHO CIEĽA – V2 -->
    <!-- ====================================== -->

    <LinearLayout
        android:id="@+id/targetPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="48dp"
        android:clickable="true"
        android:orientation="vertical"
        android:padding="18dp"
        android:background="@drawable/bg_panel_card"
        android:elevation="16dp">

        <!-- NADPIS -->
        <TextView
            android:id="@+id/targetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vybrané miesto"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#263238"
            android:paddingBottom="8dp" />

        <!-- SÚRADNICE -->
        <TextView
            android:id="@+id/targetCoordinates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Súradnice"
            android:textSize="15sp"
            android:textColor="#455A64"
            android:paddingBottom="4dp" />

        <!-- VZDIALENOSŤ -->
        <TextView
            android:id="@+id/targetDistance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vzdialenosť"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#263238"
            android:paddingBottom="12dp" />

        <!-- TYP TRASY -->
        <Button android:id="@+id/savePlaceButton" android:layout_width="match_parent" android:layout_height="48dp"
            android:text="Uložiť miesto" android:textAllCaps="false" android:contentDescription="Uložiť vybrané miesto" />
        <LinearLayout
            android:id="@+id/routeOptionsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="10dp">

            <Button
                android:id="@+id/walkRouteButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="Pešo"
                android:textSize="14sp" />

            <Space
                android:layout_width="5dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/bikeRouteButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="Bicykel"
                android:textSize="14sp" />

            <Space
                android:layout_width="5dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/carRouteButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="Auto"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- PRIDAŤ BOD TRASY -->
        <Button
            android:id="@+id/addRoutePointButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Pridať bod do trasy"
            android:textSize="15sp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="6dp" />

        <!-- HLAVNÉ TLAČIDLÁ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/navigateButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:text="Navigovať sem"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/cancelTargetButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="0.45"
                android:text="✕"
                android:textSize="18sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- ====================================== -->
    <!-- PANEL ÚPRAVY TRASY -->
    <!-- ====================================== -->

    <LinearLayout android:id="@+id/routeEditPanel" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:layout_marginBottom="30dp"
        android:clickable="true" android:orientation="vertical" android:padding="10dp" android:background="@drawable/bg_panel_card" android:elevation="18dp" android:visibility="gone">
        <TextView android:id="@+id/routeEditTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Naplánuj si trasu" android:textSize="19sp" android:textStyle="bold" android:textColor="#17352C" />
        <Button android:id="@+id/routeModeButton" android:layout_width="match_parent" android:layout_height="44dp" android:text="Režim: po cestách a chodníkoch" android:textAllCaps="false" />
        <TextView android:id="@+id/routeEditInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#455A64" />
        <Button android:id="@+id/drawRouteButton" android:layout_width="match_parent" android:layout_height="44dp" android:text="Kresliť prstom" android:textAllCaps="false" android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/undoRoutePointButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Späť" android:textAllCaps="false" />
            <Button android:id="@+id/manageRoutePointsButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Body" android:textAllCaps="false" />
            <Button android:id="@+id/clearRoutePointsButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Zmazať" android:textAllCaps="false" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/cancelRouteEditButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Zrušiť" android:textAllCaps="false" />
            <Button android:id="@+id/finishRouteEditButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="Použiť trasu" android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- ====================================== -->
    <!-- NAVIGAČNÝ PANEL -->
    <!-- ====================================== -->

    <LinearLayout
        android:id="@+id/navigationPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="10dp"
        android:layout_marginTop="82dp"
        android:layout_marginEnd="84dp"
        android:clickable="true"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_panel_card"
        android:elevation="18dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/navigationInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pokračujte rovno"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#263238"
            android:paddingBottom="5dp" />

        <TextView
            android:id="@+id/navigationInstructionDistance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ďalší pokyn"
            android:textSize="16sp"
            android:textColor="#455A64"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/navigationRemaining"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Zostávajúca trasa"
            android:textSize="15sp"
            android:textColor="#455A64"
            android:paddingBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/editNavigationRouteButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Upraviť trasu"
                android:textSize="14sp" android:textAllCaps="false"
                android:minWidth="0dp" android:paddingStart="4dp" android:paddingEnd="4dp" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/stopNavigationButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Ukončiť"
                android:textSize="14sp" android:textAllCaps="false"
                android:minWidth="0dp" android:paddingStart="4dp" android:paddingEnd="4dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- KOMPAS OVERLAY -->
    <FrameLayout
        android:id="@+id/compassOverlay"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="16dp"
        android:elevation="20dp"
        android:visibility="gone"
        android:background="@android:color/transparent">

    </FrameLayout>

    <TextView android:id="@+id/mapAttribution"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:background="#EFFFFFFF"
        android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="4dp"
        android:textSize="10sp" android:textColor="#263238" android:textColorLink="#17372E"
        android:elevation="24dp" android:importantForAccessibility="yes" />

</FrameLayout>
